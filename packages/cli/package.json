{
  "name": "@theoven/cli",
  "version": "0.6.1",
  "description": "The Oven CLI \u2014 scaffold, run, build and inspect Oven apps",
  "keywords": [
    "bun",
    "oven",
    "cli",
    "framework"
  ],
  "homepage": "https://theoven.app",
  "bugs": {
    "url": "https://github.com/hiteshchoudhary/theoven/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiteshchoudhary/theoven.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*.ts"
  },
  "bin": {
    "oven": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@theoven/core": "workspace:^"
  }
}
