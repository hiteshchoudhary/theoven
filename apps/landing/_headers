/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro fingerprints these filenames, so they can be cached forever.
# Note the /docs prefix: Starlight is mounted under it, so the old bare /_astro/* rule
# stopped matching anything when the landing page took over the site root.
/docs/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/docs/pagefind/*
  Cache-Control: public, max-age=86400

# Generated imagery is content-stable; a long cache is safe and these are the heaviest files.
/assets/*
  Cache-Control: public, max-age=604800

# Fingerprinted at build time (scripts/fingerprint.mjs), so the filename changes whenever the
# contents do. That makes "new HTML, cached old stylesheet" impossible rather than merely
# short-lived — which it was not, at an hour: it rendered as a broken page, not a stale one.
/styles.*.css
  Cache-Control: public, max-age=31536000, immutable
/main.*.js
  Cache-Control: public, max-age=31536000, immutable

# The HTML must never be cached, or it would keep pointing at an asset that no longer exists.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
