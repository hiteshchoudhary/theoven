{
  "name": "oven-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@theoven/*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docs:dev": "bun run --cwd apps/web dev",
    "example:minimal": "bun run --cwd examples/minimal dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release": "changeset publish",
    "docs:build": "bun run --cwd apps/web build",
    "docs:preview": "bun run --cwd apps/web preview",
    "site:build": "bash scripts/build-site.sh",
    "site:preview": "bun x serve dist",
    "check:links": "bun scripts/check-links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "^3.0.0",
    "@readme/openapi-parser": "^7.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "autocannon": "^8.0.0",
    "better-auth": "^1.7.1",
    "elysia": "^1.4.29",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "hono": "^4.13.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
