{
  "name": "oven-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@theoven/*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docs:dev": "bun run --cwd apps/web dev",
    "example:minimal": "bun run --cwd examples/minimal dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "^3.0.0",
    "@types/bun": "^1.3.14",
    "elysia": "^1.4.29",
    "hono": "^4.13.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
